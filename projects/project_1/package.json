{
  "name": "dopaimint-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5179",
    "build": "node scripts/sync-cradleflow.mjs && tsc -b && vite build",
    "preview": "vite preview --port 4179",
    "start": "bun server.mjs",
    "qa": "node scripts/qa-landing.mjs",
    "audio:build": "node scripts/build-audio.mjs",
    "audio:elevenlabs": "node scripts/generate-elevenlabs-audio.mjs",
    "video:studio": "npx remotion studio src/remotion/index.ts",
    "video:render": "npx remotion render src/remotion/index.ts NasaHackathon1080x700 public/submission/dopaimint-demo-28s.mp4 --overwrite && npx remotion render src/remotion/index.ts DopaiMintFullLaunch1080p public/submission/dopaimint-cyberpunk-1080p.mp4 --overwrite",
    "submission:media": "node scripts/build-submission-media.mjs"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.78.0",
    "@number-flow/react": "^0.6.2",
    "@remotion/cli": "^4.0.543",
    "@remotion/google-fonts": "^4.0.543",
    "@remotion/player": "^4.0.543",
    "@remotion/transitions": "^4.0.543",
    "ascii.rest": "^0.4.0",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "lucide-react": "^0.511.0",
    "motion": "^14.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.543",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
